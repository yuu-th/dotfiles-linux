// ============================================================
// niri config — yuuth-home-desk
//
// 正本は chezmoi 管理下（GitHub: yuu-th/dotfiles-linux）。
// このファイルを直接編集したら `chezmoi add ~/.config/niri/config.kdl`。
//
// 【所有権の境界】SETUP.md ルール 06
//   dms/*.kdl   … DMS の自動生成物。絶対に手で編集しない（上書きされる）
//   config.kdl  … 自分の領域。DMS が扱わない設定だけを書く
//   my-binds.kdl … 自分のキーバインド
//
// 【DMS に任せているもの】ここには書かない。二重管理になる
//   出力（モニタの配置・解像度・スケール） → DMS の表示設定 UI
//   gaps / border / focus-ring / 配色       → dms/layout.kdl, dms/colors.kdl
//   キーバインド一式                        → dms/binds.kdl
//
// 【include の挙動】niri 26.04 で実機検証済み（2026-08-17）
//   - 同一ファイル内の同名トップレベルブロック重複 → ハードエラー
//   - include をまたいだ場合 → 統合される
//   - 競合したときは「後に読まれた方が勝つ」
//   - optional=true → ファイルが無くても警告のみで読み込み継続
//     ※ optional 無しで include 先が欠けると設定全体が読めずログイン不能
// ============================================================

input {
    keyboard {
        // HHKB Hybrid（US 配列）。半角/全角キーが無いので IME 切替は Ctrl+Space
        xkb {
            layout "us"
        }
        repeat-delay 300
        repeat-rate 40
    }

    // Kensington SlimBlade Pro は udev が ID_INPUT_TRACKBALL=1 を付けるため、
    // niri は mouse{} ではなく trackball{} の設定を適用する。
    // ここを mouse{} に書いても一切効かない（実機で確認、2026-08-17）。
    //   udevadm info /dev/input/event14 | grep ID_INPUT
    trackball {
        // デバイス側の DPI 切替を最低にしても速すぎたため、niri 側でも落とす。
        //
        // accel-profile は書かない = libinput 既定の "adaptive"（加速あり）。
        // トラックボールは指の可動域が狭く、画面端まで運ぶのに加速が要る。
        // 切り分けのため一時的に "flat"（加速なし）で試したが、一定速度で
        // 間延びするので既定に戻した。
        //
        // accel-speed は adaptive では単純な倍率ではなく加速カーブ全体のシフト。
        // 範囲は -1.0（最遅）〜 1.0、0.0 が既定。遅すぎたら 0 に近づける。
        accel-speed -0.3
    }

    // フォーカス移動にポインタを追従させる。2 画面でポインタを見失いにくい
    warp-mouse-to-focus

    // 逆向きも有効にする。ポインタを動かしたらフォーカスが付いてくる。
    //
    // max-scroll-amount="0%" は外さないこと。これが無いと、画面端にはみ出して
    // いる隣の列にポインタが少し触れただけでフォーカスが移り、
    // それを見せるために**ビューが横スクロールする**。
    // 0% = 「スクロールせずに見えている窓」にだけフォーカスを移す。
    //
    // 2026-08-18 に default-column-width を全幅から半分へ変えたので、列が 2 本まで
    // なら両方見えていて誤爆しない。**3 本目からは以前と同じ状況になるので残す。**
    //
    // warp-mouse-to-focus との併用は問題ない。キーでフォーカスを move すると
    // ポインタがそこへ飛び、その位置の窓は既にフォーカス済みなので何も起きない。
    //
    // 副作用: モニタ境界を越えるとフォーカス中の出力が変わるため、
    // index 参照のバインド（Mod+7〜9）が指す先も変わる。名前参照は影響なし。
    focus-follows-mouse max-scroll-amount="0%"
}

// ------------------------------------------------------------
// レイアウト（自分の領域）
//
// 方針: ウィンドウは既定で半分（1920px の出力に 2 本並ぶ）。広げるのも狭めるのも E / R。
//
// 【既定を全幅から半分へ変えた】2026-08-18。ターミナル（Alacritty）が常に全幅で
//   開くのが邪魔だった。preset-column-widths の 2 番目と同じ値なので、新しい窓から
//   そのまま E で 1/3、R で全幅へ回せる（プリセットに無い値を既定にすると
//   switch-preset-column-width の出発点が曖昧になるが、その問題は起きない）。
//   **全アプリに効く。**Brave も半分で開く。特定のアプリだけ全幅にしたいときは
//   window-rule で default-column-width を上書きする。
//
// 【トグルではなく「前後」で扱う】2026-08-18 に 2 段 → 4 段へ変更した。
//
//   「Mod+R は全幅⇔半分の 2 段トグル、Mod+E は 1/3⇔1/4 の別トグル」を検討したが
//   niri の設定では書けない。実機で確かめた制約が 3 つ:
//     ① preset-column-widths は設定全体で 1 本だけ。2 本目（preset-window-widths）は
//        存在しない（unexpected node。switch-preset-window-width というアクションは
//        あるが対応する設定ノードが無い）
//     ② 1 バインドに書けるのは 1 アクションだけ
//        （only one action is allowed per keybind と明示的に落ちる）
//     ③ 条件分岐の仕組みが無い。set-column-width も状態を持たない
//   → 状態を見て分岐するにはスクリプトを spawn するしかないので、それはやめた。
//
//   1 本のリストを前後に回す形にした。
//     Mod+E … switch-preset-column-width       縮小（リストを前に進める）
//     Mod+R … switch-preset-column-width-back  拡大（リストを後ろに戻す）
//   全幅⇔半分の往復は行き E・帰り R で 1 打鍵ずつなのでトグル感は残る。
//   失うのは「R 連打で全幅に戻る」だけ。
//
// 並び順を変えると E / R の意味も変わる。**狭くなる順に並べること。**
// 両端では折り返す（1/4 で E を押すと全幅、全幅で R を押すと 1/4。実測）。
//
// gaps / border / focus-ring は DMS が所有するのでここには書かない。
// ------------------------------------------------------------
layout {
    default-column-width { proportion 0.5; }

    preset-column-widths {
        proportion 1.0      // 全幅
        proportion 0.5      // 半分
        proportion 0.333    // 3 分割
        proportion 0.25     // 4 分割
    }
}

// ------------------------------------------------------------
// ワークスペース（自分の領域。DMS は workspace を一切宣言しない）
//
// 【思想】ワークスペースが第一級の器で、モニタは「それが今たまたま乗っている場所」。
//   窓がモニタに属してワークスペースがその下にある、ではない。
//   niri に move-workspace-to-monitor-* があるのがその証拠。
//   → だから移動は「隣のモニタへ」ではなく「あのワークスペースへ」で指名する。
//
// 【実機で確かめた 2 つの事実】2026-08-18
//   ① index 参照はモニタローカル。両モニタに idx 1 が同時に存在する。
//      DVI にフォーカス中の `focus-workspace 1` は DVI の 1 番目に行き、
//      HDMI の 1 番目には辿り着けない。番号は行き先を指名できない。
//   ② 名前参照はグローバルで、モニタを越える。
//      HDMI 側のワークスペースに名前を付け、DVI から `focus-workspace <名前>`
//      → モニタのフォーカスごと HDMI へ飛んだ。
//      move-column-to-workspace も同じ参照解決を使う。
//
//   よって「行き先を選べる移動」は名前付きワークスペースでしか表現できない。
//
//   ③ 参照は KDL の型で index / 名前に分岐する。裸の数値 = index、
//      引用符付き = 名前。`focus-workspace 300` は「number too large to fit in
//      target type」で落ちるが `focus-workspace "300"` は通ることで確認した。
//      → ここの "1"〜"6" は引用符が必須。外すと index 参照になり意味が変わる。
//      ※ CLI（niri msg action focus-workspace 1）は型が無いので index 優先に
//        なり、名前 "1" には届かない。CLI から名前 "1" を指すことはできない。
//
//   詳細は docs/niri-workspaces.md。
//
// 【配置】ユーザーの呼び方: 1 枚目 = 右 = DVI-D-1（常時接続）
//                          2 枚目 = 左 = HDMI-A-1（KVM で MacBook と共有）
//   HDMI が切れている間は open-on-output の指定先が無いので、
//   niri が残っている出力（DVI）へ寄せる。復帰時の挙動は未検証（LEDGER 参照）。
//
// ここで宣言したワークスペースは常設になる（空でも消えない）。
// 宣言していないものは従来どおり動的（空になると消える）。
// ------------------------------------------------------------

// 【宣言順】起動時は宣言順どおりに上から並ぶ（入れ子 niri で検証、2026-08-18）。
//   逆順になるのは「稼働中に宣言を足して再読み込みしたとき」だけで、
//   その場合は先頭へ挿入される。既存の名前付きワークスペースは再読み込みでは
//   並び替わらないので、途中で足して順序を直したいなら
//   move-workspace-to-index で手で直すか、ログインし直す。

// 2 枚目（左・HDMI-A-1）。1 / 2 は役割なしの作業用
workspace "1" { open-on-output "HDMI-A-1"; }
workspace "2" { open-on-output "HDMI-A-1"; }
workspace "daily" { open-on-output "HDMI-A-1"; }   // Mod+A 日常ブラウジング
workspace "work"  { open-on-output "HDMI-A-1"; }   // Mod+S 仕事ブラウジング

// 1 枚目（右・DVI-D-1）
workspace "3" { open-on-output "DVI-D-1"; }
workspace "4" { open-on-output "DVI-D-1"; }
workspace "5" { open-on-output "DVI-D-1"; }
workspace "6" { open-on-output "DVI-D-1"; }
workspace "discord" { open-on-output "DVI-D-1"; }  // Mod+D
workspace "spotify" { open-on-output "DVI-D-1"; }  // Mod+F

// 常に自分のワークスペースで開く。
//
// 【罠】.desktop の StartupWMClass を信じてはいけない。実機で確認（2026-08-18）。
//   Spotify は StartupWMClass=spotify だが実際の app-id は "Spotify"（大文字 S）。
//   `^spotify$` では一致せず、ルールが無言で素通りして無名ワークスペースに開いた。
//   正規表現は必ず (?i) で大文字小文字を無視させる。
//   確認方法: niri msg -j windows で app_id を直接見る。
//
// ブラウザは daily / work が同じアプリ（app-id はどちらも brave-origin）なので
// ルールでは区別できない。手で置く。
window-rule {
    match app-id=r#"(?i)^discord$"#
    open-on-workspace "discord"
}

window-rule {
    match app-id=r#"(?i)^spotify$"#
    open-on-workspace "spotify"
}

// XWayland。Steam などの X11 アプリに必要（SETUP.md Phase 5-4）
xwayland-satellite {
    path "/usr/bin/xwayland-satellite"
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

prefer-no-csd

// ------------------------------------------------------------
// 日本語入力（fcitx5 + Mozc）
//
// fcitx5 の起動は spawn-at-startup ではなく systemd user unit
// （~/.config/systemd/user/fcitx5.service）で行う。理由:
//   - niri.desktop の Exec が niri-session のため niri #2283 に該当し、
//     spawn-at-startup では XWayland アプリ（Steam）から IME が使えなくなる
//   - SETUP.md ルール 07「常駐サービスは必ず systemd unit にする」
//   - GNOME セッション（逃げ道）でも同じ unit が使える
//
// niri #3917 回避: 変換候補ウィンドウがタイル扱いされて列を占有するのを防ぐ。
// niri 26.04 では再現しない可能性があるが無害なので予防的に残す。
// ------------------------------------------------------------
window-rule {
    match app-id="fcitx" title="^Fcitx5 Input Window$"
    open-floating true
}

// ------------------------------------------------------------
// Steam（SETUP.md Phase 5-4）
//
// 通知トーストがタイルに入り込んで列を占有するのを防ぎ、右下に浮かせる。
//
// ゲームの起動オプションには gamescope を噛ませること。niri にはカーソル拘束が
// 無く、2 画面構成ではフルスクリーンゲームからポインタが抜ける。
//   gamescope -f -w 1920 -h 1080 -W 1920 -H 1080 --force-grab-cursor --backend sdl -- %command%
// --backend sdl は必須（Wayland バックエンドはカーソルロックを正しく扱えない）。
// このマシンは両モニタとも 1920x1080 なので上記の解像度でそのまま使える。
// ------------------------------------------------------------
window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
}

// ------------------------------------------------------------
// include
//
// 順序に意味がある。後に読まれた定義が勝つので、
// DMS 所有領域 → 自分の領域 の順に並べること。
// ------------------------------------------------------------
include "dms/colors.kdl"      optional=true
include "dms/layout.kdl"      optional=true
include "dms/alttab.kdl"      optional=true
include "dms/cursor.kdl"      optional=true
include "dms/outputs.kdl"     optional=true
include "dms/windowrules.kdl" optional=true
include "dms/wpblur.kdl"      optional=true
include "dms/binds.kdl"       optional=true

include "my-binds.kdl"        optional=true
