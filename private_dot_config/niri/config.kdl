// ============================================================
// niri config — yuuth-home-desk
//
// 正本は chezmoi 管理下（GitHub: yuu-th/dotfiles-linux）。
// このファイルを直接編集したら `chezmoi add ~/.config/niri/config.kdl` を忘れないこと。
//
// 【所有権の境界】SETUP.md ルール 06
//   dms/*.kdl  … DMS の自動生成物。絶対に手で編集しない（上書きされる）
//   このファイル … 自分の領域（入力・出力・起動時プロセス）
//   my-binds.kdl … 自分のキーバインド。DMS のバインドを上書きする
//
// 【include の挙動】niri 26.04 で実機検証済み（2026-08-17）
//   - 同一ファイル内の同名トップレベルブロック重複 → ハードエラー
//   - include をまたいだ場合 → 統合される（エラーにならない）
//   - optional=true → ファイルが無くても警告のみで読み込み継続
//     ※ optional 無しで include 先が欠けると設定全体が読めずログイン不能になる
// ============================================================

input {
    keyboard {
        // HHKB Hybrid（US 配列）。半角/全角キーは無いので IME 切替は Ctrl+Space
        xkb {
            layout "us"
        }
        repeat-delay 300
        repeat-rate 40
    }

    mouse {
        // Kensington SlimBlade Pro Trackball
        // 加速の調整が要るようなら accel-profile "flat" を試す
    }

    // フォーカス移動時にポインタを追従させる。
    // マルチモニタでポインタを見失いにくくなる（niri 26.04 の機能）
    warp-mouse-to-focus
}

// ------------------------------------------------------------
// 出力
//
// DVI-D-1 … Linux 専用。常時接続。ここが主モニタ
// HDMI-A-1 … KVM 切替器で MacBook と共有。切替のたびに disconnect される
//
// niri のワークスペースはモニタごとに独立・動的なので、HDMI-A-1 が切り離されると
// その上のワークスペースは DVI-D-1 へ退避する。位置を固定しておくと復帰時の
// 並びが安定する。
//
// ※ DMS の表示設定 UI は dms/outputs.kdl に書き込む。そちらで設定した場合は
//    この 2 ブロックを削ってどちらか一方に寄せること（二重管理を作らない）
// ------------------------------------------------------------
output "DVI-D-1" {
    mode "1920x1080"
    position x=0 y=0
}

output "HDMI-A-1" {
    mode "1920x1080"
    position x=1920 y=0
}

// XWayland。Steam などの X11 アプリに必要（SETUP.md Phase 5-4）
xwayland-satellite {
    path "/usr/bin/xwayland-satellite"
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

prefer-no-csd

// ------------------------------------------------------------
// include（DMS 所有領域 → 自分の領域 の順）
// 後に読まれた定義が優先されるため、my-binds.kdl を最後に置く
// ------------------------------------------------------------
include "dms/colors.kdl"      optional=true
include "dms/layout.kdl"      optional=true
include "dms/alttab.kdl"      optional=true
include "dms/cursor.kdl"      optional=true
include "dms/outputs.kdl"     optional=true
include "dms/windowrules.kdl" optional=true
include "dms/binds.kdl"       optional=true

include "my-binds.kdl"        optional=true
